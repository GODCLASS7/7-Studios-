# Ignore the output video from Git but not videos you import into src/.
out
build

# Per-machine benchmark and timing history (keep timings if you want estimates to learn across machines)
production/bench.json
jobs/*/.*.resolved.json

# Frame captures for storyboard/frames sheets; `npm run storyboard` re-renders them every run.
public/jobs/*/panels/

# Footage-edit working files: transcription temp files, local Whisper, timeline frames, reference downloads.
production/tmp/
production/whisper/
public/jobs/*/timeline/
references/*/*
!references/*/analysis.md
jobs/*/.timeline.json
# Built by `npm run edl` (voice tracks) and by the test fixture (synthetic take).
public/jobs/*/edit/
public/jobs/edit-test/footage/
production/matte-venv/
production/models/
public/jobs/*/matte/
# Test-only media made from fixtures and earlier renders.
public/jobs/look-test/footage/
public/jobs/look-test/reels/
# Test material rebuilt by `npm test` (scripts/test/run.mjs): fixture footage, music beds, stand-in b-roll.
public/jobs/reframe-test/footage/
public/jobs/shorts-test/footage/
public/jobs/prelive-test/broll/
public/audio/test/
# The site-capture test job, rebuilt from scripts/test/assets/site by npm test.
jobs/site-test/
public/jobs/site-test/
jobs/*/beats-*.json
# The tutorial test's screen recording, rendered from the TestScreen composition by npm test.
public/jobs/tutorial-test/screen/
# Frames picked from a video for carousels (npm run carousel -- <job> frames rebuilds them).
public/jobs/*/carousel/
# Trial versions the tests build from look-test's plan (npm run variants).
jobs/look-test-t*/
__pycache__/
# 7 Studios engine: generated media, the gallery index, settings for this machine,
# requests waiting for Claude, character images and training sets.
public/gallery/
public/characters/
production/gallery.json
production/engine.json
