# Copy to .env (git-ignored) and fill in. Never paste keys into chat.
# ElevenLabs: Speech to Text + forced alignment for `npm run transcribe`.
# Create the key at elevenlabs.io → API keys with "Speech to Text" set to Access.
ELEVENLABS_API_KEY=
# Optional: transcription model (default scribe_v2).
# ELEVENLABS_STT_MODEL=scribe_v2
# Optional: whisper.cpp version for --engine=whisper (default 1.5.5).
# WHISPER_CPP_VERSION=1.5.5

# fal.ai: the Premium generation engine (hosted models, paid per run). The app's
# Settings can write this for you. Check each model's price before using it.
FAL_KEY=

# Optional: point the Open engine at ComfyUI somewhere else for this run
# (normally set in the app's Settings, or npm run gen -- engine set open.url=…).
# OPEN_ENGINE_URL=http://127.0.0.1:8188

# Optional: cloud rendering on your own AWS account (Remotion Lambda; scripts/render-cloud.mjs).
# Create an IAM user with the policy `npx remotion lambda policies user` prints.
# REMOTION_AWS_ACCESS_KEY_ID=
# REMOTION_AWS_SECRET_ACCESS_KEY=
# REMOTION_AWS_REGION=us-east-1
